<div class="layout layout--col gap lg:gap--large h--full">

  <div class="flex w--full p--1 flex--center-y">
    <div class="flex flex--center-y stretch">
      <img src="data:image/webp;base64," alt="Joulo logo" width="75" height="32" class="h-6 dark:hidden">
    </div>
    <div class="value--xsmall flex">
      <div class="label--small">
        €{{ ere_price_mid }}/ERE (week {{ ere_price_week }})
      </div>
    </div>
  </div>

  <div id="{{chart_id}}" style="width: 100%; flex-grow: 1;"></div>

  <div class="p--1 grid grid--cols-1 gap--large">
    {% capture data_title %}
    {% if total_value_eur_ytd %}Geschatte waarde{% else %}Prijs onbekend{% endif %}
    {% endcapture %}

    {% capture data_value %}
    {% if total_value_eur_ytd %}{{ total_value_eur_ytd }}{% else %}-{% endif %}
    {% endcapture %}

    {% render "dataPoint", 
    title: data_title,
    value: data_value,
    icon: "hgi-money-04", 
    unit: "€" %}

        {% render "dataPoint", 
    title: "ERE Credits", 
    value: total_ere_credits_ytd, 
    icon: "hgi-ticket-02", 
    unit: "Credits" %}

    {% assign data_title = "Geladen in " | append: year %}
    {% render "dataPoint", 
    title: data_title, 
    value: total_kwh_ytd, 
    icon: "hgi-energy-ellipse", 
    unit: "kWh" %}
  </div>
</div>

<script src="https://trmnl.com/js/highcharts/12.3.0/highcharts.js"></script>
<script type="text/javascript">
  var monthData = {{ chart_data | json }} || [];
  var ereData = {{ chart_data_ere | json }} || [];

  function renderChart() {
    Highcharts.chart('{{chart_id}}', {
      chart: {
        type: 'areaspline',
        backgroundColor: 'transparent',
        animation: false,
        spacing: [0, 0, 0, 0]
      },
      title: { text: null },
      xAxis: {
        categories: monthData.map(function (p) { return p[0]; }),
        labels: { enabled: false },
        lineColor: '#e2e2e2',
        tickColor: '#000',
        gridLineWidth: 0
      },
      yAxis: {
        title: { text: null },
        labels: { enabled: false },
        gridLineWidth: 0,
        min: 0,
        maxPadding: 0.2
      },
      plotOptions: {
        series: {
          animation: false,
          enableMouseTracking: false,
          states: { hover: { enabled: false } }
        }
      },
      series: [
        {
          type: 'areaspline',
          data: monthData.map(function (p) { return p[1]; }),
          name: 'kWh',
          zIndex: 2,
          lineColor: '#2e2e2e',
          lineWidth: 2,
          marker: { enabled: true, radius: 4, fillColor: '#2e2e2e' },
          threshold: 0,
          fillColor: {
            linearGradient: { x1: 0, y1: 0, x2: 0, y2: 1 },
            stops: [
              [0, 'rgba(0, 0, 0, 0.1)'],
              [1, 'rgba(255, 255, 255, 0)']
            ]
          },
          dataLabels: {
            enabled: false,
            useHTML: true,
            allowOverlap: true,
            format: '<span class="bg--gray-75 p--2 px--3 rounded--full flex"><strong class="chart-label__month">{point.category}</strong><span class="chart-label__value">{point.y}kWh</span></span>',
            style: { fontSize: '11px', color: '#000', fontWeight: 'normal', textOutline: 'none' },
            y: -16
          }
        },
        {
          type: 'spline',
          data: ereData.map(function (p) { return p[1]; }),
          name: 'ERE credits',
          zIndex: 4,
          color: '#757575',
          dashStyle: 'ShortDash',
          lineWidth: 2,
          marker: { enabled: true, radius: 3, fillColor: '#757575' },
          dataLabels: {
            enabled: false,
            useHTML: true,
            allowOverlap: true,
            format: '<span class="bg--white p--2 px--3 rounded--full">{point.y} ERE</span>',
            style: { fontSize: '11px', color: '#757575', fontWeight: 'normal', textOutline: 'none' },
            y: -10
          }
        },
        {
          type: 'scatter',
          data: monthData.length ? [[monthData.length - 1, monthData[monthData.length - 1][1]]] : [],
          marker: { enabled: true, radius: 8, symbol: 'circle', fillColor: '#000', lineColor: '#fff', lineWidth: 3 },
          enableMouseTracking: false,
          dataLabels: { enabled: false },
          zIndex: 10
        }
      ],
      tooltip: { enabled: false },
      legend: { enabled: false },
      credits: { enabled: false }
    });
  }

  document.addEventListener('DOMContentLoaded', renderChart);
</script>
